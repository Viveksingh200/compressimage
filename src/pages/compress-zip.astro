          <span class="px-2.5 py-0.5 rounded-full bg-surface-100 dark:bg-surface-800 font-medium">Compress zip file to 100KB</span>
          <span class="px-2.5 py-0.5 rounded-full bg-surface-100 dark:bg-surface-800 font-medium">Compress zip file to 500KB</span>
          <span class="px-2.5 py-0.5 rounded-full bg-surface-100 dark:bg-surface-800 font-medium">Compress zip file to 2MB</span>
        </div>
      </div>

      <!-- Main ZIP Compressor Tool -->
