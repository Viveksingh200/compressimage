  </section>

  <!-- How It Works / Deep Dive Section -->
  <section class="py-16 sm:py-20 border-b border-surface-200 dark:border-surface-800 bg-surface-50 dark:bg-[#0e1626]/40 transition-colors">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-brand-600 dark:text-brand-400 tracking-wider uppercase">Optimization Guide</span>
