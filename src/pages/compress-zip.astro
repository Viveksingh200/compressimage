        <p class="text-sm sm:text-base text-surface-500 dark:text-surface-400 mt-2">
          Step-by-step answers on how to compress zip files, how to compress folders/videos into a zip, and how to reduce archive sizes.
        </p>
      </div>

      <div class="space-y-4">
        {zipFaqs.map((f, i) => (
          <details class="bg-white dark:bg-[#131b2e] border border-surface-200 dark:border-surface-800 rounded-xl p-6 group [&_summary::-webkit-details-marker]:hidden shadow-subtle cursor-pointer transition-colors" open={i === 0 || i === 1}>
            <summary class="flex items-center justify-between font-bold text-base sm:text-lg text-surface-900 dark:text-white list-none select-none">
              <span>{f.q}</span>
              <span class="ml-4 transition-transform group-open:rotate-180 text-surface-400 dark:text-surface-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="text-sm sm:text-base text-surface-600 dark:text-surface-300 leading-relaxed mt-3.5 pt-3.5 border-t border-surface-100 dark:border-surface-800 font-normal whitespace-pre-line">
