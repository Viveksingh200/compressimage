---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress AVIF Images Online - Next-Gen Image Codec Compression"
  description="Compress AVIF files online or convert photos to AVIF. Ultra high compression ratio for modern web browsers."
  canonicalUrl="https://compressimagesize.com/compress-avif"
>
  <HeroSection 
    headline="Compress AVIF Images Online"
    subheading="Compress AVIF images with next-gen codec efficiency. Reduce file size up to 50% smaller than WebP and JPG."
    format="avif"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
