---
const faqs = [
  {
    q: "How to compress image size online?",
    a: "To compress image size online, drag and drop your photo into onlinecompressimage.com. Select your desired preset (e.g. 50 KB, 100 KB, 200 KB, or Custom Quality) and click 'Compress Images'. Download your compressed photo instantly with zero server uploads."
  },
  {
    q: "How to compress image size in mobile (iPhone, iPad & Android / iOS)?",
    a: "Open onlinecompressimage.com in your mobile browser (Safari, Chrome, or Firefox). Tap 'Browse Files', select photos from your iPhone or Android gallery, choose your target KB size, and tap compress. No app installation required."
  },
  {
    q: "How to compress image size in laptop or Mac?",
    a: "On your laptop or computer, drag and drop single photos, multiple files, or `.zip` folders directly into our browser compressor. Adjust resolution or target KB limits and click 'Compress Images' to download your optimized files."
  },
  {
    q: "How to compress JPG / JPEG images?",
    a: "Upload your JPG or JPEG photo to our compressor. Our browser engine optimizes quantization tables and strips bloated EXIF camera metadata to reduce JPG file size up to 80% while retaining sharpness."
  },
  {
    q: "How to compress image to 50KB, 100KB, or 20KB?",
    a: "Select the '50 KB' or '100 KB' preset pill. For specific requirements like 20KB for passport or government forms, enter '20' in the target size input box. Our smart algorithm automatically computes the optimal canvas quality and dimensions."
  },
  {
    q: "How to compress image without losing quality?",
    a: "To compress images without visible quality loss, convert your images to modern WEBP or AVIF formats or use an 80-85% quality setting. This removes redundant color bytes while preserving crisp edges."
  },
  {
    q: "How to compress image in Microsoft Paint?",
    a: "In MS Paint, open your image, click 'Resize' on the Home tab, reduce the percentage or pixel width/height, and click 'Save As' JPEG. For automatic target size compression, use onlinecompressimage.com directly in your web browser."
  },
  {
    q: "How to compress a file or folder into a ZIP file?",
    a: "To compress any file or folder into a ZIP archive, use our free online ZIP compressor at onlinecompressimage.com/compress-zip. Alternatively, right-click any file or folder on Windows and select 'Compress to ZIP file', or right-click on Mac and select 'Compress'."
  },
  {
    q: "How to compress a ZIP file further to smaller size?",
    a: "To compress an existing ZIP file further, use our online ZIP optimizer. It re-encodes files with Maximum DEFLATE Level 9 and applies Smart Deep Compression to images inside the archive, reducing archive weight by up to 75% without corrupting documents or code."
  },
  {
    q: "How to compress videos into a ZIP file?",
    a: "Since video formats (MP4, MOV, MKV) are already pre-compressed, standard ZIP compression only reduces file size by 1-2%. For best results, reduce video bitrate or resolution first, then bundle your videos into a single organized ZIP file using our tool."
  },
  {
    q: "Is onlinecompressimage.com free and private?",
    a: "Yes! It is 100% free with no registration, no file caps, and zero server uploads. All image and ZIP calculations run locally in your web browser."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<section class="py-16 sm:py-24 border-b border-surface-200 dark:border-surface-800 bg-surface-50 dark:bg-[#0e1626]/50 transition-colors duration-150">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="text-center mb-12">
      <span class="text-xs font-semibold text-brand-600 dark:text-brand-400 tracking-wider uppercase">Got Questions?</span>
      <h2 class="text-2xl sm:text-4xl font-bold text-surface-900 dark:text-white tracking-tight mt-1.5">
        Frequently Asked Questions
      </h2>
      <p class="text-sm sm:text-base text-surface-500 dark:text-surface-400 mt-2">
        Guides and answers for compressing images on mobile, iPhone, laptop, and target KB sizes.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((f, i) => (
        <details class="bg-white dark:bg-[#131b2e] border border-surface-200 dark:border-surface-800 rounded-xl p-6 group [&_summary::-webkit-details-marker]:hidden shadow-subtle cursor-pointer transition-colors" open={i === 0}>
          <summary class="flex items-center justify-between font-bold text-base sm:text-lg text-surface-900 dark:text-white list-none select-none">
            <span>{f.q}</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-surface-400 dark:text-surface-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <p class="text-sm sm:text-base text-surface-600 dark:text-surface-300 leading-relaxed mt-3.5 pt-3.5 border-t border-surface-100 dark:border-surface-800 font-normal">
            {f.a}
          </p>
        </details>
      ))}
    </div>

  </div>
</section>
