---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress PNG Images Online - Reduce PNG Size & Convert to WebP"
  description="Compress PNG graphics and transparent images online. Shrink PNG file size or convert to WebP to save up to 70% space."
  canonicalUrl="https://onlinecompressimage.com/compress-png"
>
  <HeroSection 
    headline="Compress PNG Images Online"
    subheading="Reduce PNG file sizes while preserving transparency and sharp vector/logo edges. 100% private browser processing."
    format="png"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
