---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress Image to 50KB Online Free - JPG, PNG & WebP Optimizer"
  description="Reduce and compress image file size to 50KB or less online for government forms, passport photos, and websites. 100% free and client-side private."
  canonicalUrl="https://onlinecompressimage.com/compress-to-50kb"
>
  <HeroSection 
    headline="Compress Image to 50KB Online"
    subheading="Reduce JPG, PNG, and WebP images to 50KB or below for passport applications, government portals, and online forms. 100% private in browser."
    presetKb="50kb"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
