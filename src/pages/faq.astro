---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
---

<Layout
  title="FAQ - Image Compression & Privacy Questions Answered"
  description="Learn how our in-browser image and ZIP compression engine works, security guarantees, target size presets, and format support."
  canonicalUrl="https://onlinecompressimage.com/faq"
>
  <div class="pt-12 pb-4 text-center">
    <h1 class="text-3xl sm:text-5xl font-bold text-surface-900 tracking-tight">Help & FAQ</h1>
    <p class="text-surface-500 text-sm sm:text-base mt-2 max-w-xl mx-auto">
      Answers to common questions about file size reduction, ZIP extraction, and privacy.
    </p>
  </div>

  <FAQSection />
  <FeatureGrid />
</Layout>
