---
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-surface-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-sm shadow-subtle group-hover:bg-brand-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-base text-surface-900 tracking-tight leading-tight">compressimagesize<span class="text-brand-600">.com</span></span>
        <span class="text-[10px] text-surface-500 font-medium">Browser Image & ZIP Optimizer</span>
      </div>
    </a>

    <!-- Nav links -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-surface-600">
      <a href="/compress-to-100kb" class="hover:text-surface-900 transition-colors">100KB Preset</a>
      <a href="/compress-to-200kb" class="hover:text-surface-900 transition-colors">200KB Preset</a>
      <a href="/zip-image-compressor" class="hover:text-surface-900 transition-colors">ZIP Compressor</a>
      <a href="/bulk-image-compressor" class="hover:text-surface-900 transition-colors">Bulk Compression</a>
      <a href="/faq" class="hover:text-surface-900 transition-colors">FAQ</a>
    </nav>

    <!-- Right Badge & Action -->
    <div class="flex items-center gap-3">
      <a href="#compress-tool" class="px-3.5 py-1.5 bg-brand-600 hover:bg-brand-700 text-white font-medium text-xs rounded-lg transition-colors shadow-subtle">
        Compress Now
      </a>
    </div>

  </div>
</header>
