---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Image Resizer Online - Scale Resolution & Dimension Limits"
  description="Resize image dimensions and resolution online. Scale down photo height and width while reducing file size."
  canonicalUrl="https://compressimagesize.com/image-resizer"
>
  <HeroSection 
    headline="Image Resizer & Scaling Tool"
    subheading="Scale down image resolution and dimensions by percentage or custom limits while maintaining crisp aspect ratios."
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
