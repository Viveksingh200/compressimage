---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import SupportedFormats from '../components/SupportedFormats.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress Images to Any Size Online - Free JPG, PNG, WebP & ZIP Compressor"
  description="Compress JPG, PNG, WebP and ZIP files directly in your browser. Choose your target size in 100KB, 200KB, 500KB or 1MB. 100% private with no server uploads."
>
  <HeroSection 
    headline="Compress Images to Any Size Online"
    subheading="Compress JPG, PNG, WebP and ZIP files directly in your browser. Choose your target size in KB or MB. No uploads. No registration. Private and lightning fast."
  />
  <FeatureGrid />
  <WorkflowSection />
  <SupportedFormats />
  <FAQSection />
</Layout>
