---
import CompressionApp from './CompressionApp.jsx';

interface Props {
  headline?: string;
  subheading?: string;
  presetKb?: string;
  format?: string;
}

const {
  headline = "Compress Images to Any Size Online",
  subheading = "Compress JPG, PNG, WebP and ZIP files directly in your browser. Choose your target size in KB or MB. No uploads. No registration. Private and lightning fast.",
  presetKb = "custom",
  format = "original"
} = Astro.props;
---

<section id="compress-tool" class="relative pt-10 pb-16 md:pt-14 md:pb-24 border-b border-surface-200 dark:border-surface-800 bg-grid-pattern transition-colors duration-150">
  
  <!-- Subtle linear radial blur overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-white via-white/80 to-white dark:from-[#0b0f19] dark:via-[#0b0f19]/80 dark:to-[#0b0f19] pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Hero Header Text -->
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-4 mb-8 sm:mb-12">

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-surface-900 dark:text-white leading-[1.1]">
        {headline}
      </h1>

      <p class="text-base sm:text-lg text-surface-500 dark:text-surface-400 font-normal leading-relaxed max-w-2xl">
        {subheading}
      </p>

    </div>

    <!-- Main Compression Application Dropzone -->
    <div id="upload-area" class="w-full">
      <CompressionApp client:only="react" initialPreset={presetKb} initialFormat={format} />
    </div>

  </div>

</section>
