---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress Image to 500KB Online Free - High Quality Size Reducer"
  description="Compress high-resolution photos to 500KB. Ideal for professional web publishing, e-commerce listings, and blog graphics."
  canonicalUrl="https://compressimagesize.com/compress-to-500kb"
>
  <HeroSection 
    headline="Compress Image to 500KB Online"
    subheading="Scale and optimize multi-megapixel camera photos down to 500KB for fast website loading and responsive web design."
    presetKb="500kb"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
