        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-6 rounded-2xl bg-white dark:bg-[#131b2e] border border-surface-200 dark:border-surface-800 shadow-subtle">
          <div class="w-10 h-10 rounded-xl bg-brand-100 dark:bg-brand-900/60 text-brand-700 dark:text-brand-300 flex items-center justify-center font-bold text-sm mb-4">
            1
