---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress Image to 200KB Online Free - Instant Size Reducer"
  description="Compress photos to 200KB online. Smart precision compression engine to reduce JPG, PNG, and WebP images to 200KB limit."
  canonicalUrl="https://onlinecompressimage.com/compress-to-200kb"
>
  <HeroSection 
    headline="Compress Image to 200KB Online"
    subheading="Compress photos and graphics down to 200KB without visible quality loss. Instant client-side browser optimization."
    presetKb="200kb"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
