---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404 - Page Not Found | compressimagesize.com"
  description="The page you are looking for does not exist. Return to compressimagesize.com to compress JPG, PNG, WebP, and ZIP files."
>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <div class="w-16 h-16 rounded-2xl bg-brand-50 text-brand-600 border border-brand-100 flex items-center justify-center font-bold text-2xl mb-6 shadow-subtle">
      404
    </div>
    
    <h1 class="text-3xl sm:text-5xl font-bold text-surface-900 tracking-tight mb-3">
      Page Not Found
    </h1>
    
    <p class="text-sm sm:text-base text-surface-500 max-w-md mb-8 leading-relaxed">
      Sorry, the page you are looking for doesn't exist or has been moved. Use our free tool to compress images and ZIP files.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a 
        href="/"
        class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs sm:text-sm rounded-lg transition-all shadow-subtle flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Return to Home & Compressor
      </a>
      <a 
        href="/faq"
        class="px-6 py-3 bg-surface-100 hover:bg-surface-200 text-surface-700 font-semibold text-xs sm:text-sm rounded-lg border border-surface-200 transition-all"
      >
        View Help & FAQ
      </a>
    </div>
  </div>
</Layout>
