---
const standardSteps = [
  { step: "01", title: "Upload Images", desc: "Drag & drop JPG, PNG, WEBP, or AVIF files into the upload zone." },
  { step: "02", title: "Choose Target Size", desc: "Select a preset like 100 KB, 200 KB, or 500 KB or adjust custom quality." },
  { step: "03", title: "Compress Instantly", desc: "Browser canvas engine optimizes image resolution and quality fitting." },
  { step: "04", title: "Download Result", desc: "Inspect before/after comparison and download individual or batch files." }
];

const zipSteps = [
  { step: "01", title: "Upload ZIP Archive", desc: "Drag and drop any `.zip` file containing single or nested image folders." },
  { step: "02", title: "Automatic Extraction", desc: "JSZip unpacks image files in browser memory while preserving structure." },
  { step: "03", title: "Compress Every Image", desc: "Each extracted photo is compressed to your specified target size." },
  { step: "04", title: "Download Re-Zipped Archive", desc: "Bundles all compressed output files back into a single downloadable `.zip`." }
];
---

<section class="py-16 sm:py-24 border-b border-surface-200 bg-surface-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="max-w-2xl mx-auto text-center mb-14">
      <span class="text-xs font-semibold text-brand-600 tracking-wider uppercase">Simple Workflows</span>
      <h2 class="text-2xl sm:text-4xl font-bold text-surface-900 tracking-tight mt-1.5">
        How Compression Works
      </h2>
      <p class="text-sm sm:text-base text-surface-500 mt-2">
        Transparent 4-step workflow for regular images and zip archives.
      </p>
    </div>

    {/* Standard Workflow */}
    <div class="mb-14">
      <div class="flex items-center gap-2 mb-6">
        <div class="w-3 h-3 rounded-full bg-brand-600"></div>
        <h3 class="font-bold text-lg text-surface-900">Standard Image Workflow</h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {standardSteps.map((s, i) => (
          <div class="bg-white border border-surface-200 rounded-xl p-5 relative shadow-subtle flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md border border-brand-100">{s.step}</span>
              <h4 class="font-semibold text-sm text-surface-900 mt-3 mb-1">{s.title}</h4>
              <p class="text-xs text-surface-500 leading-relaxed">{s.desc}</p>
            </div>
            {i < standardSteps.length - 1 && (
              <div class="hidden md:block absolute -right-3 top-1/2 -translate-y-1/2 z-10 bg-white border border-surface-200 rounded-full p-1 text-surface-400">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    {/* ZIP Workflow */}
    <div>
      <div class="flex items-center gap-2 mb-6">
        <div class="w-3 h-3 rounded-full bg-success"></div>
        <h3 class="font-bold text-lg text-surface-900">ZIP File Workflow</h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {zipSteps.map((s, i) => (
          <div class="bg-white border border-surface-200 rounded-xl p-5 relative shadow-subtle flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold text-success-600 bg-success-50 px-2.5 py-1 rounded-md border border-success/20">{s.step}</span>
              <h4 class="font-semibold text-sm text-surface-900 mt-3 mb-1">{s.title}</h4>
              <p class="text-xs text-surface-500 leading-relaxed">{s.desc}</p>
            </div>
            {i < zipSteps.length - 1 && (
              <div class="hidden md:block absolute -right-3 top-1/2 -translate-y-1/2 z-10 bg-white border border-surface-200 rounded-full p-1 text-surface-400">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
