---
---

<header class="sticky top-0 z-40 bg-white/95 dark:bg-[#0b0f19]/95 backdrop-blur-md border-b border-surface-200 dark:border-surface-800 transition-colors duration-150">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 group min-w-0">
      <div class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-sm shadow-subtle group-hover:bg-brand-700 transition-colors flex-shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="font-bold text-sm sm:text-base text-surface-900 dark:text-white tracking-tight leading-tight truncate">Compress Image <span class="text-brand-600 dark:text-brand-400">Online</span></span>
        <span class="text-[10px] text-surface-500 dark:text-surface-400 font-medium hidden sm:inline">Browser Image & ZIP Optimizer</span>
      </div>
    </a>

    <!-- Desktop Nav links -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-surface-600 dark:text-surface-300">
      <a href="/compress-to-100kb" class="hover:text-surface-900 dark:hover:text-white transition-colors">100KB Preset</a>
      <a href="/compress-to-200kb" class="hover:text-surface-900 dark:hover:text-white transition-colors">200KB Preset</a>
      <a href="/compress-zip" class="hover:text-surface-900 dark:hover:text-white transition-colors">ZIP Compressor</a>
      <a href="/bulk-image-compressor" class="hover:text-surface-900 dark:hover:text-white transition-colors">Bulk Compression</a>
      <a href="/faq" class="hover:text-surface-900 dark:hover:text-white transition-colors">FAQ</a>
    </nav>

    <!-- Right Actions: Theme Toggle & CTA -->
    <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
      
      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle Dark Mode"
        class="p-2 rounded-xl text-surface-600 dark:text-surface-300 hover:text-surface-900 dark:hover:text-white hover:bg-surface-100 dark:hover:bg-surface-800 border border-surface-200 dark:border-surface-700 transition-colors shadow-subtle flex items-center justify-center cursor-pointer select-none"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block text-amber-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden text-surface-600 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a href="#compress-tool" class="hidden sm:inline-flex px-3.5 py-1.5 bg-brand-600 hover:bg-brand-700 text-white font-medium text-xs rounded-lg transition-colors shadow-subtle items-center gap-1">
        <span>Compress Now</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button 
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        class="md:hidden p-2 text-surface-600 dark:text-surface-300 hover:text-surface-900 dark:hover:text-white hover:bg-surface-100 dark:hover:bg-surface-800 rounded-lg transition-colors border border-surface-200 dark:border-surface-700"
      >
        <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Panel -->
  <div 
    id="mobile-menu-panel" 
    class="hidden md:hidden border-t border-surface-200 dark:border-surface-800 bg-white dark:bg-[#0e1626] px-4 pt-3 pb-5 space-y-2 animate-fade-in shadow-modal"
  >
    <a href="/compress-to-50kb" class="block px-3 py-2 text-xs font-medium text-surface-700 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-surface-50 dark:hover:bg-surface-800/60 rounded-lg transition-colors">
      Compress to 50KB
    </a>
    <a href="/compress-to-100kb" class="block px-3 py-2 text-xs font-medium text-surface-700 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-surface-50 dark:hover:bg-surface-800/60 rounded-lg transition-colors">
      Compress to 100KB
    </a>
    <a href="/compress-to-200kb" class="block px-3 py-2 text-xs font-medium text-surface-700 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-surface-50 dark:hover:bg-surface-800/60 rounded-lg transition-colors">
      Compress to 200KB
    </a>
    <a href="/compress-to-500kb" class="block px-3 py-2 text-xs font-medium text-surface-700 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-surface-50 dark:hover:bg-surface-800/60 rounded-lg transition-colors">
      Compress to 500KB
    </a>
    <a href="/compress-zip" class="block px-3 py-2 text-xs font-medium text-surface-700 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-surface-50 dark:hover:bg-surface-800/60 rounded-lg transition-colors">
      Compress ZIP File
    </a>
    <a href="/bulk-image-compressor" class="block px-3 py-2 text-xs font-medium text-surface-700 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-surface-50 dark:hover:bg-surface-800/60 rounded-lg transition-colors">
      Bulk Image Compressor
    </a>
    <a href="/faq" class="block px-3 py-2 text-xs font-medium text-surface-700 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-surface-50 dark:hover:bg-surface-800/60 rounded-lg transition-colors">
      FAQ & Help
    </a>
  </div>
</header>

<script is:inline>
  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobilePanel = document.getElementById('mobile-menu-panel');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (mobileBtn && mobilePanel) {
    mobileBtn.addEventListener('click', () => {
      const isExpanded = !mobilePanel.classList.contains('hidden');
      if (isExpanded) {
        mobilePanel.classList.add('hidden');
        openIcon.classList.remove('hidden');
        openIcon.classList.add('block');
        closeIcon.classList.remove('block');
        closeIcon.classList.add('hidden');
      } else {
        mobilePanel.classList.remove('hidden');
        openIcon.classList.remove('block');
        openIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        closeIcon.classList.add('block');
      }
    });
  }

  // Dark mode toggle
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (_) {}
    });
  }
</script>
