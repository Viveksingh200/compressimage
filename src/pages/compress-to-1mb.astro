---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress Image Below 1MB Online Free - Reduce Photo File Size"
  description="Reduce large photos to under 1MB online. Shrink 10MB+ high resolution camera images to less than 1MB instantly."
  canonicalUrl="https://compressimagesize.com/compress-to-1mb"
>
  <HeroSection 
    headline="Compress Image Below 1MB Online"
    subheading="Easily compress 10MB+ DSLR camera images or graphics to under 1MB. High-fidelity browser canvas rendering."
    presetKb="1mb"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
