            <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs font-bold flex-shrink-0">✓</span>
            <span class="text-xs text-surface-600 dark:text-surface-300"><strong>Compress zip file free</strong> on iPhone, Android, Mac, and Windows with zero software installation.</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <WorkflowSection />
  <FeatureGrid />

  <!-- Comprehensive ZIP FAQ Section addressing all user queries -->
  <section class="py-16 sm:py-24 border-b border-surface-200 dark:border-surface-800 bg-surface-50 dark:bg-[#0e1626]/50 transition-colors duration-150">
