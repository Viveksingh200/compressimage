---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress Image to 100KB Online Free - Bulk Photo Size Reducer"
  description="Compress JPG, PNG, and WebP images to under 100KB instantly. Perfect for email attachments, web upload limits, and application portals."
  canonicalUrl="https://onlinecompressimage.com/compress-to-100kb"
>
  <HeroSection 
    headline="Compress Image to 100KB Online"
    subheading="Reduce single or bulk image file sizes to 100KB or below directly in your browser. Maximum quality fitting with zero server uploads."
    presetKb="100kb"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
