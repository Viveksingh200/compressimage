---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
}

const {
  title = "Compress Images Online - Free JPG, PNG & WebP",
  description = "Compress JPG, PNG, WebP and ZIP files directly in your browser. Choose your target size in 100KB, 200KB, 500KB or 1MB. 100% private with no server uploads.",
  keywords = "compress image size, image compressor, compress image online, reduce image size, compress jpg, compress png, compress image to 100kb, compress image to 200kb, compress zip images",
  canonicalUrl = "https://onlinecompressimage.com"
} = Astro.props;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Compress Image Online",
    "url": canonicalUrl
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Compress Image Online",
    "url": canonicalUrl,
    "description": description,
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }
];
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <meta name="referrer" content="no-referrer-when-downgrade" />

  <!-- Verification Meta Tags -->
  <meta name="msvalidate.01" content="43C566D129B5C61B6A21625E028E1D58" />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Compress Image Online" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalUrl} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NPV9HMQ23S"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-NPV9HMQ23S');
  </script>

  <!-- Theme Initialization Script (Zero-FOUC & System Preference) -->
  <script is:inline>
    (function() {
      try {
        const storedTheme = localStorage.getItem('theme');
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

        if (storedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          // Default to user's system OS theme
          if (mediaQuery.matches) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }

        // Listen for live system theme changes when no manual override exists
        mediaQuery.addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) {
            if (e.matches) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          }
        });
      } catch (_) {}
    })();
  </script>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="bg-white dark:bg-[#0b0f19] text-surface-900 dark:text-surface-100 font-sans antialiased min-h-full flex flex-col selection:bg-brand-100 selection:text-brand-800 dark:selection:bg-brand-900/50 dark:selection:text-brand-200 transition-colors duration-150">
  <Navbar />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
