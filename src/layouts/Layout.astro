---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
}

const {
  title = "Compress Images to Any Size Online - Free JPG, PNG, WebP & ZIP Compressor",
  description = "Compress JPG, PNG, WebP and ZIP files directly in your browser. Choose your target size in 100KB, 200KB, 500KB or 1MB. 100% private with no server uploads.",
  keywords = "compress image size, image compressor, compress image online, reduce image size, compress jpg, compress png, compress image to 100kb, compress image to 200kb, compress zip images",
  canonicalUrl = "https://onlinecompressimage.com"
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Compress Image Size",
  "url": canonicalUrl,
  "description": description,
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

