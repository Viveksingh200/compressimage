---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress WebP Images Online - WebP Optimizer & Converter"
  description="Compress WebP images online or convert JPG/PNG to modern WebP format for fast web page load speed."
  canonicalUrl="https://onlinecompressimage.com/compress-webp"
>
  <HeroSection 
    headline="Compress WebP Images Online"
    subheading="Optimize WebP files for maximum web performance. Convert photos to WebP format with custom KB target sizes."
    format="webp"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
