---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Compress JPG Images Online - Free Bulk JPG Reducer"
  description="Compress JPG & JPEG photos online to your exact target size in KB or MB. Reduce JPG file size up to 80% without quality loss."
  canonicalUrl="https://onlinecompressimage.com/compress-jpg"
>
  <HeroSection 
    headline="Compress JPG Images Online"
    subheading="Compress single or bulk JPG and JPEG photos directly in your browser. Choose target size in KB or MB. Private and fast."
    format="jpg"
  />
  <FeatureGrid />
  <WorkflowSection />
  <FAQSection />
</Layout>
